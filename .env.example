# Offline local development defaults; no API keys or external services required.
DEMO_MODE=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=
SUPABASE_JWT_SECRET=

DATABASE_URL=sqlite+aiosqlite:///./data/support.db
CHECKPOINT_DB_PATH=./data/checkpoints.db
REDIS_URL=
USE_FAKE_REDIS=true

LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake
EMBEDDING_DIMENSIONS=384
VECTOR_STORE=memory
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=clouddesk_knowledge

APPROVAL_REQUIRED_FOR_REFUNDS=true
MAX_REFUND_WITHOUT_APPROVAL=0
TOOL_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=120
SAMPLE_DATA_DIR=sample_data

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=clouddesk-support
LOG_LEVEL=INFO
